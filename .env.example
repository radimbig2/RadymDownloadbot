BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
SECRET_KEY=YOUR_ADMIN_SECRET_KEY
COMMON_KEY=YOUR_USER_SECRET_KEY

# Inline mode (@bot link). Enable it for the bot with /setinline in @BotFather.
# The bot must be an administrator allowed to post in this private storage channel.
INLINE_STORAGE_CHAT_ID=-1004377346553
# How long an inline query waits before showing the "Check again" result.
INLINE_QUERY_WAIT_SECONDS=8

# Optional: YouTube authentication via env secret
# Recommended for hosting/container deployments
YTDLP_COOKIES_BASE64=PASTE_BASE64_NETSCAPE_COOKIES_HERE

# Optional: Instagram authentication via a separate env secret
# Export only Instagram cookies; do not reuse the YouTube cookie jar.
# INSTAGRAM_COOKIES_BASE64=PASTE_BASE64_NETSCAPE_INSTAGRAM_COOKIES_HERE
# Local development alternative:
# INSTAGRAM_COOKIES_FILE=.secrets/instagram-cookies.txt

# Optional: TikTok authentication for login/age-restricted posts.
# Priority: TIKTOK_COOKIES_BASE64, TIKTOK_COOKIES, TIKTOK_COOKIES_FILE.
# TIKTOK_COOKIES_BASE64=PASTE_BASE64_NETSCAPE_TIKTOK_COOKIES_HERE
# Local development alternative:
# TIKTOK_COOKIES_FILE=.secrets/tiktok-cookies.txt

# Optional: YouTube max duration in seconds
# Default is 300 seconds (5 minutes) if omitted
YOUTUBE_MAX_DURATION_SECONDS=300

# Optional: X post downloads
# X_BEARER_TOKEN takes priority.
# X_BEARER_TOKEN=YOUR_X_APP_BEARER_TOKEN
# X_CONSUMER_KEY=YOUR_X_APP_CONSUMER_KEY
# X_SECRET_KEY=YOUR_X_APP_SECRET_KEY
# X_ACCESS_TOKEN=YOUR_X_ACCESS_TOKEN
# X_ACCESS_TOKEN_SECRET=YOUR_X_ACCESS_TOKEN_SECRET

# Optional: yt-dlp request pacing
YTDLP_SLEEP_REQUESTS=1.0
YTDLP_SLEEP_INTERVAL=2.0
YTDLP_MAX_SLEEP_INTERVAL=5.0

# Optional: impersonation target for yt-dlp
# Example: chrome, edge, safari
# YTDLP_IMPERSONATE=chrome

# Optional: raw Netscape cookies as multiline env text instead of base64
# YTDLP_COOKIES=

# Optional: raw Instagram Netscape cookies instead of base64
# INSTAGRAM_COOKIES=

# Optional: raw TikTok Netscape cookies instead of base64
# TIKTOK_COOKIES=
