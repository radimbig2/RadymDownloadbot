BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
SECRET_KEY=YOUR_ADMIN_SECRET_KEY
COMMON_KEY=YOUR_USER_SECRET_KEY

# Optional: YouTube authentication via env secret
# Recommended for hosting/container deployments
YTDLP_COOKIES_BASE64=PASTE_BASE64_NETSCAPE_COOKIES_HERE

# Optional: YouTube max duration in seconds
# Default is 300 seconds (5 minutes) if omitted
YOUTUBE_MAX_DURATION_SECONDS=300

# X post downloads use snscrape and do not require X API credentials

# Optional: yt-dlp request pacing
YTDLP_SLEEP_REQUESTS=1.0
YTDLP_SLEEP_INTERVAL=2.0
YTDLP_MAX_SLEEP_INTERVAL=5.0

# Optional: impersonation target for yt-dlp
# Example: chrome, edge, safari
# YTDLP_IMPERSONATE=chrome

# Optional: raw Netscape cookies as multiline env text instead of base64
# YTDLP_COOKIES=